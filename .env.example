# Copy this file to .env and fill in real values. Never commit .env.

# GitHub Models / Copilot inference API key used by GitHubModelsProvider.
# If unset, SuggestionEngine automatically falls back to detection-only mode (see architecture.md NFR-4).
GITHUB_MODELS_TOKEN=

# Optional: override the default GitHub Models endpoint.
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference/chat/completions

# Optional: Confluence publish support (only used when --publish is passed explicitly).
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
